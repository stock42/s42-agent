{
  "name": "s42-agent",
  "version": "0.1.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "description": "A Bun coding harness with a QBasic-style terminal UI, project tabs and local LLM support.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stock42/s42-agent.git"
  },
  "homepage": "https://github.com/stock42/s42-agent#readme",
  "bugs": { "url": "https://github.com/stock42/s42-agent/issues" },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run index.ts",
    "typecheck": "bun ./node_modules/typescript/bin/tsc --noEmit",
    "test": "bun test",
    "build": "bun build ./index.ts --compile --outfile ./dist/s42-agent",
    "build:targets": "bun run scripts/build-targets.ts",
    "build:release": "bun run scripts/build-release.ts",
    "build:compare": "bun run scripts/build-targets.ts --compare",
    "smoke:binary": "bun run scripts/smoke-binary.ts"
  },
  "engines": {
    "bun": "1.4.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
